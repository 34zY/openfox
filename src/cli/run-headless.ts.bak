import type { Mode } from '../server/config.js'

// Agent one-shot headless. Necessite le bootstrap complet du moteur (initDatabase +
// initEventStore + ProviderManager + SessionManager + createSession + agent-loop),
// cf src/server/index.ts et src/server/chat/orchestrator.ts (runAgentTurn).
// Scaffold en place; le cablage du moteur est la prochaine etape (voir docs plan).
export async function runHeadlessTask(
  task: string | undefined,
  _mode: Mode,
  _opts: { json?: boolean },
): Promise<number> {
  if (!task || !task.trim()) {
    console.error('Usage: openfox run "<task>" [--json]')
    return 1
  }
  console.error(
    "openfox run (agent headless) n'est pas encore cable. " +
      'Outils web dispo en CLI: `openfox search \"...\"` et `openfox fetch <url>`. ' +
      "Pour un agent complet, lance `openfox` (UI web) en attendant le cablage du moteur headless.",
  )
  return 2
}
